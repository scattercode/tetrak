# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments — any of the common names
.venv/
venv/
env/

# Processing directories — keep directory structure but ignore runtime contents.
# Add your images to workspace/scans/ to process them; they will be moved to
# workspace/processed/.
workspace/scans/*
!workspace/scans/.gitkeep
workspace/processed/*
!workspace/processed/.gitkeep
workspace/triage/*
!workspace/triage/.gitkeep

# Run log — runtime output, one line per event, appended across runs.
workspace/*.jsonl

# Test artefacts
.pytest_cache/
.coverage

# Environment variables — never commit your API keys
.env

# macOS
.DS_Store

# Editable install
.venv/
*.egg-info/
src/*.egg-info/

# Generated by hatch-vcs at build time from the git tag.
src/tetrak_ocr/_version.py

# The comparison deck is a build artefact: regenerate it with
# `python tools/generate_presentation.py` rather than committing megabytes
# of binary that change whenever the benchmark does.
collateral/

# Google Drive sync scratch directory. Appears at the repo root, is large,
# and is not ours.
.tmp.driveupload/

# Hugo build output, asset cache and per-build artefacts. The site lives in
# site/, so these are scoped to it rather than matching anything at the root.
/site/public/
/site/resources/
node_modules/
.hugo_build.lock
hugo_stats.json

# Generated reference page. Rebuilt from docstrings before every build, so
# committing it would just be a second copy to go stale.
/site/content/reference/api.md
test-results/
playwright-report/

# Rendered corpus images cached by tools/generate_presentation.py. Derived from
# evaluation/ocr/corpus/images/ and regenerated on demand.
tools/.image-cache/

# Sphinx build output and autosummary-generated module stubs. Regenerated by
# sphinx-build on every build; committing them would be a second copy to go
# stale, same reasoning as /site/content/reference/api.md above.
/docs/_build/
/docs/generated/

# Cached OCR spans for the layout experiments -- regenerable by
# tools/dump_layout_spans.py, and specific to the weights that produced them.
evaluation/layout/spans/

# Review snapshot tarballs: working artefacts, never part of the tree.
.tetrak-review*.tgz

# Personal editor workspaces, e.g. with private companion repositories.
*.local.code-workspace
