# Copy to .env before `docker compose up`. These are local proof-of-concept
# credentials for a service bound to 127.0.0.1 -- they are not secrets, and
# nothing here should ever be pointed at real collection material.
OMEKA_DB_NAME=omeka
OMEKA_DB_USER=omeka
OMEKA_DB_PASSWORD=omeka
OMEKA_DB_ROOT_PASSWORD=omeka-root
